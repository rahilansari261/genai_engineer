# All optional — vision and transcription both have free local defaults
# (Ollama's moondream, and faster-whisper) that need no keys at all.

OPENAI_API_KEY=
# Needed for: OpenAI vision (gpt-4o-mini), DALL-E image generation,
# OpenAI Whisper transcription, and text-to-speech (the only TTS engine
# this backend has — the free alternative is the browser itself, see the
# frontend, not this file).

HF_TOKEN=
# Needed for: the free Hugging Face image-generation option.
# Get a free token at https://huggingface.co/settings/tokens

# Where Ollama is listening. This default matches a native `ollama serve`;
# only change it if your Ollama runs somewhere else.
OLLAMA_HOST=http://localhost:11434
