# All optional except where noted — the app runs fully on the free local
# Chroma index + Ollama with nothing filled in here at all.

# LLM providers for the generation step (Ollama needs no key — it's wired
# up automatically via docker-compose.yml).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only used if you set vector_store to "pinecone" for the raw pipeline.
# Free tier: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# Only needed if you're NOT using docker-compose (e.g. running this
# backend natively against an Ollama already running on your host).
OLLAMA_HOST=http://localhost:11434
