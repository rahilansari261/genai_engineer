# All optional except where noted — the app runs fully on the free local
# Chroma index + Ollama with nothing filled in here at all.

# LLM providers for the generation step (Ollama needs no key — it just
# needs to be running on your machine, see OLLAMA_HOST below).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Only used if you set vector_store to "pinecone" for the raw pipeline.
# Free tier: https://app.pinecone.io -> API Keys
PINECONE_API_KEY=

# Where Ollama is listening. This default matches a native `ollama serve`;
# only change it if your Ollama runs somewhere else.
OLLAMA_HOST=http://localhost:11434
