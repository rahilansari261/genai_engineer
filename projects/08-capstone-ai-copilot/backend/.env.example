# All optional — the copilot runs fully free on Ollama + local
# faster-whisper + the local handbook index with nothing filled in here.
# Safety (content moderation) specifically needs OPENAI_API_KEY to run at
# all; without it, the safety toggle still works but only enforces the
# system-prompt layer, not the moderation layer (same as Project 2).

OPENAI_API_KEY=
# Unlocks: content moderation, OpenAI as the main reasoning provider,
# OpenAI vision, DALL-E image generation, OpenAI Whisper.

HF_TOKEN=
# Unlocks: the free Hugging Face image-generation tool.
# Get a free token at https://huggingface.co/settings/tokens

# Only needed if you're NOT using docker-compose.
OLLAMA_HOST=http://localhost:11434
