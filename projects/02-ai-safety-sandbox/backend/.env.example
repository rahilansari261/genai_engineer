# OPENAI_API_KEY powers two things here: the chat model (if you pick "openai"
# as the provider) AND the Moderation API check, which only exists on OpenAI.
# Without it, the moderation checkbox in the UI will say "unavailable" but
# the guard-mode (none/basic/strong) system prompts still work fine on their own.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_HOST=http://localhost:11434

# Which websites are allowed to call this backend from a browser (CORS).
# Comma-separated, exact origins (no path). Locally the default is enough;
# once the frontend is hosted (e.g. on Vercel), add its URL, like:
#   CORS_ORIGINS=https://my-app.vercel.app,http://localhost:3000
# Left empty, it falls back to http://localhost:3000.
CORS_ORIGINS=http://localhost:3000
