# Optional — the ReAct engine works fully free/local on Ollama with
# nothing filled in here. OPENAI_API_KEY is required for the "functions"
# and "responses" engines, and to use OpenAI as a provider in the ReAct engine.
OPENAI_API_KEY=

# Only needed if you're NOT using docker-compose (e.g. running natively
# against an Ollama already running on your host).
OLLAMA_HOST=http://localhost:11434
